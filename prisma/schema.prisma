// This is your Prisma schema file,
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Course {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  city        String   @default("")
  holes       Int      @default(0)
  rating      Float?
  classification String @default("")
  isTop       Boolean  @default(false)
  isNew       Boolean  @default(false)
  mapUrl      String?

  // Detail fields (populated on-demand from detail page)
  address     String?
  zipCode     String?
  latitude    Float?
  longitude   Float?
  founded     String?
  basketType  String?
  teeType     String?
  terrain     String?
  signage     String?
  courseType  String?
  maintenance String?
  courseMaster String?
  designer    String?
  isFree      String?
  moreInfo    String?
  winterPlay  String?
  description String?
  descriptionFull String?
  scorecardUrl String?
  ratingCount Int?
  detailFetchedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Hole-by-hole descriptions (from Väyläkuvaukset section)
  holeDetails Hole[]
}

model Hole {
  id          Int      @id @default(autoincrement())
  courseId    Int
  holeNumber Int      // 1, 2, 3...
  name       String   // e.g. "KIPPIS Inter DGP #1"
  length     Int?     // meters (null if not available)
  par        Int?     // null if not available
  note       String?  // e.g. "HUOM! 3-väylä ei ole toistaiseksi pelattavissa."
  imageUrl   String?  // full-size hole image URL
  thumbUrl   String?  // thumbnail image URL

  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, holeNumber])
}
